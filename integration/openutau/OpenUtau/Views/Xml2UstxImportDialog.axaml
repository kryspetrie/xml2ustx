<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Views.Xml2UstxImportDialog"
        Icon="/Assets/open-utau.ico"
        Title="{DynamicResource dialogs.xml2ustx.import.caption}"
        Height="200" Width="420" WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="{Binding $parent.WindowDecorationMargin}" Spacing="8">
    <TextBlock Margin="8,8,8,0" Text="{DynamicResource dialogs.xml2ustx.import.projectname}"/>
    <TextBox Margin="8,0" Text="{Binding ProjectName}"/>
    <TextBlock Margin="8,0" Text="{DynamicResource dialogs.xml2ustx.import.trackpreset}"/>
    <ComboBox Margin="8,0" HorizontalAlignment="Stretch"
              ItemsSource="{Binding TrackConfigIds}"
              SelectedItem="{Binding SelectedTrackConfigId}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
      <Button Content="{DynamicResource dialogs.xml2ustx.import.ok}" Margin="4" Click="OnOk" Width="90"/>
      <Button Content="{DynamicResource dialogs.xml2ustx.import.cancel}" Margin="4" Click="OnCancel" Width="90"/>
    </StackPanel>
  </StackPanel>
</Window>
