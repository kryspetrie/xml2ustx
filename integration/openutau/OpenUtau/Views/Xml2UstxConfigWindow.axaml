<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Views.Xml2UstxConfigWindow"
        Icon="/Assets/open-utau.ico"
        Title="{DynamicResource dialogs.xml2ustx.config.caption}"
        Width="720" Height="520" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="{Binding $parent.WindowDecorationMargin}">
    <TextBox Name="ConfigBox" Grid.Row="0" Margin="8" AcceptsReturn="True" TextWrapping="Wrap"
             FontFamily="monospace"/>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
      <Button Content="{DynamicResource dialogs.xml2ustx.config.openfolder}" Margin="4" Click="OnOpenFolder"/>
      <Button Content="{DynamicResource dialogs.xml2ustx.config.reset}" Margin="4" Click="OnReset"/>
      <Button Content="{DynamicResource dialogs.xml2ustx.config.save}" Margin="4" Click="OnSave" Width="90"/>
      <Button Content="{DynamicResource dialogs.xml2ustx.config.close}" Margin="4" Click="OnClose" Width="90"/>
    </StackPanel>
  </Grid>
</Window>
